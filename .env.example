# ──────────────────────────────────────────────────────────────────────
# Step 4 — Multi-Source RAG  |  .env.example
# Copy to .env and fill in real values. NEVER commit your real .env.
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────

# ── Generate LLM: Groq PRIMARY → Gemini FALLBACK on rate-limit ──
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.0-flash

# ── Judge LLM: config-driven via an OpenAI-compatible endpoint ──
# (Step 4 reverses Step 3's emphasis: the JUDGE reads LLM_BASE_URL + LLM_API_KEY)
LLM_BASE_URL=<your-openai-compatible-url>/v1
LLM_API_KEY=sk-...
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# ── Embedding model (first run downloads the ONNX model) ──
EMBED_MODEL=n24q02m/Qwen3-Embedding-0.6B-ONNX

# ── Optional: LangSmith tracing ──
# LANGSMITH_API_KEY=ls_...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=step4-multi-source-rag
